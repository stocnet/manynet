<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" xmlns:viz="http://gexf.net/1.3/viz" version="1.3">
  <meta lastmodifieddate="2026-01-15">
    <creator>Gephi 0.10.1</creator>
    <description>Test export</description>
  </meta>
  <graph defaultedgetype="directed" mode="static">
    <attributes class="node">
      <attribute id="0" title="department" type="string"/>
      <attribute id="1" title="seniority" type="integer"/>
      <attribute id="2" title="remote" type="boolean">
        <default>false</default>
      </attribute>
    </attributes>
    <attributes class="edge">
      <attribute id="0" title="channel" type="string"/>
    </attributes>
    <nodes>
      <node id="n0" label="Ada">
        <attvalues>
          <attvalue for="0" value="research"/>
          <attvalue for="1" value="3"/>
          <attvalue for="2" value="true"/>
        </attvalues>
        <viz:position x="10.5" y="-4.0"/>
        <viz:size value="12.0"/>
        <viz:color r="255" g="0" b="0"/>
      </node>
      <node id="n1" label="Grace">
        <attvalues>
          <attvalue for="0" value="research"/>
          <attvalue for="1" value="5"/>
        </attvalues>
        <viz:position x="-2.25" y="8.0"/>
        <viz:size value="20.0"/>
        <viz:color r="0" g="128" b="255"/>
      </node>
      <node id="n2" label="Katherine">
        <attvalues>
          <attvalue for="0" value="operations"/>
          <attvalue for="1" value="1"/>
        </attvalues>
        <viz:position x="3.0" y="3.0"/>
        <viz:size value="8.0"/>
        <viz:color r="0" g="0" b="0"/>
      </node>
    </nodes>
    <edges>
      <edge id="e0" source="n0" target="n1" weight="2.0">
        <attvalues>
          <attvalue for="0" value="email"/>
        </attvalues>
      </edge>
      <edge id="e1" source="n1" target="n2">
        <attvalues>
          <attvalue for="0" value="phone"/>
        </attvalues>
      </edge>
      <edge id="e2" source="n2" target="n0" weight="3.0" type="mutual">
        <attvalues>
          <attvalue for="0" value="email"/>
        </attvalues>
      </edge>
    </edges>
  </graph>
</gexf>
