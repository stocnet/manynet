         "SMITH J, 2001, SCIENTOMETRICS; JONES K, 2003, SCIENTOMETRICS"))
(bib <- collect_bibliography(records))
to_uniplex(bib, "cites") |> to_proximity(across = "columns")
to_mode(bib, "authors", through = "works", similarity = "fractional")
